# Server-only OpenAI credential. Never expose this with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=medium

# Private Vercel Blob store connected to this project.
BLOB_READ_WRITE_TOKEN=

# Random server-only secret, at least 32 characters, for upload ownership and expiring result links.
VISUALIZER_SESSION_SECRET=

# Optional override (1-100). Defaults: Production=3; Preview/Development=20.
VISUALIZER_GENERATION_LIMIT=

# Optional consultation delivery through Resend.
RESEND_API_KEY=
CONSULTATION_FROM_EMAIL=NEST Outdoor Systems <projects@your-verified-domain.com>
CONSULTATION_TO_EMAIL=hello@nestpergola.com
